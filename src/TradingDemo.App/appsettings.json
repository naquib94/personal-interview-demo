{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Demo": {
    // The test-support endpoints (/health, /test-support/reset) are the documented seam that
    // lets a scenario guarantee its own preconditions. See the comment in Program.cs for the
    // trade-off. In a real system this would default to false and be enabled per environment.
    "EnableTestSupport": true
  }
}
