      "Password": "Demo!Pass123",
      "Description": "An active trader with a funded demo account and existing order history."
    },
    "SuspendedTrader": {
      "Username": "trader.suspended",
      "Password": "Demo!Pass123",
      "Description": "Suspended account, for negative authorisation paths."
    }
  }
}
